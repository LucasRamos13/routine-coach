# Copy to ~/.config/routine-coach/companion.env (outside the repository) and fill in.
RC_NTFY_SERVER=https://ntfy.sh
# Use the topic generated in the app (Settings › Bot and PC relay › Generate).
# On public ntfy.sh the topic name is the only secret: anyone who knows it can read and publish.
RC_NTFY_TOPIC=replace-with-the-topic-generated-in-the-app
# Optional: ntfy access token, for a self-hosted server with access control.
RC_NTFY_TOKEN=
# Only for the Telegram bridge:
RC_TELEGRAM_TOKEN=
RC_TELEGRAM_CHAT_ID=
