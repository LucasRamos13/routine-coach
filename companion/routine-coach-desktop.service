# systemd user unit for Linux (e.g. CachyOS). Install:
#   cp routine-coach-desktop.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now routine-coach-desktop
[Unit]
Description=Routine Coach desktop reminders
After=graphical-session.target network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/routine-coach/routine_coach_companion.py --config %h/.config/routine-coach/companion.env desktop
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
